{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.fyipedia/teafyi",
  "description": "Tea knowledge API client — search tea varieties, processing methods, and terms from TeaFYI.",
  "version": "0.1.4",
  "repository": {
    "url": "https://github.com/fyipedia/teafyi",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "teafyi",
      "version": "0.1.4",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--from",
          "value": "teafyi[mcp]"
        },
        {
          "type": "positional",
          "value": "python"
        },
        {
          "type": "positional",
          "value": "-m"
        },
        {
          "type": "positional",
          "value": "teafyi.mcp_server"
        }
      ]
    }
  ]
}
